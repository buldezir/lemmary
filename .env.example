# Worker cron (stays in env; registered once at process start)
# every minute
WORKER_CRON_EXPR=* * * * *

# Largest archive an import may stage on disk, in bytes (default 1 GiB).
# A new upload replaces the account's previous one, so this is also the disk a
# single account can occupy while deciding whether to confirm.
# IMPORT_STAGING_MAX_BYTES=1073741824

# Console (stdout) slog min level: debug, info, warn, error.
# Unset = no stdout slog tee (PocketBase --dev still prints everything).
# Does not change PocketBase Admin → Settings → Logs (database) min level.
# LOG_LEVEL=info

# Passkey relying party. Both are derived from the incoming request by default,
# which is right whenever the proxy forwards the original Host. Set them when it
# does not, or to pin a parent domain. Read at startup, not from Settings.
# Every enrolled passkey is bound to PASSKEY_RP_ID - changing it makes all of
# them unusable and they have to be added again.
# PASSKEY_RP_ID=archive.example.com
# PASSKEY_ORIGINS=https://archive.example.com,https://www.archive.example.com

# Allow Paperless-ngx import to reach loopback / RFC1918 hosts (LAN or Docker).
# Link-local and cloud-metadata addresses stay blocked either way.
# IMPORT_ALLOW_PRIVATE=1

# ── AI ────────────────────────────────────────────────────────────────────
#
# Two modes, one build and one image.
#
# Self-hosted (the default). The block below seeds the AI providers and the
# model bindings on the FIRST boot only, so that `docker compose up` with a key
# in it lands on the workspace instead of the setup wizard — which is the whole
# point of it for testing. After that the Settings page is the only authority
# and these are inert: editing one and restarting changes nothing.
#
# Managed (AI_MANAGED=1). The operator owns the AI bill, so the block is
# re-applied on every boot and the Settings page loses its Providers, Models
# and Duplicates sections; the API refuses those writes too, not only the UI.
# An incomplete block refuses to start rather than serving an instance nobody
# inside it can repair.
# AI_MANAGED=1

# One key is usually the whole configuration: with AI_API_KEY and nothing else
# the app creates one provider and routes extraction, chat, Deep Search and OCR
# to it. Mistral is the provider to reach for first -- it is the only SDK that
# serves all three jobs (Document OCR, chat completions and mistral-embed), so
# one key needs nothing else bound. See docs/ai_providers.md.
AI_SDK=openai
# mistral | openai | openrouter
AI_API_KEY=
# Be sure the model supports the result language you pick in Settings.
AI_MODEL=deepseek-v4-flash
# Optional; defaults to the SDK's own endpoint.
AI_BASE_URL=https://opencode.ai/zen/go/v1

# Embeddings for Deep Search. Unset (the default) means Deep Search matches
# keywords only, which is what it did before this existed -- a working
# configuration, not a broken one. Set it and a question phrased one way finds a
# document worded another way, across languages. Operator-owned under
# AI_MANAGED=1; removing it there turns the feature off.
#
# The model runs on the AI_SDK provider above unless AI_EMBEDDING_SDK names
# another one; see the block below that.
#
# What it costs, because none of it is free:
#  - Tokens. Every document is embedded once, in ~1100-character passages plus
#    one for its metadata: roughly one embedding request per 30 KB of text.
#    Embedding models are cheap per token, but this is the whole archive.
#  - Re-embedding. A document is embedded again when its OCR text or its
#    metadata changes (a re-OCR, an edited title, a renamed tag), and every
#    document is embedded again when you change this model. There is no partial
#    migration: vectors from two models cannot be compared.
#  - Space, and on an encrypted instance that means RAM. A 1536-dimension vector
#    is ~6 KB, and a 20-page document is a handful of passages -- call it 30-60
#    KB per document inside data.db. Under VAULT_ENABLED=1 the archive is
#    decrypted into a tmpfs, so that space is memory. Prefer a model with 1024
#    dimensions or fewer if that number matters to you.
# AI_EMBEDDING_MODEL=text-embedding-3-small

# A separate provider for embeddings, shaped like the OCR_* block further down:
# an SDK, its credential, its address. Unset, embeddings run on the AI_SDK
# provider, which is what they always did.
#
# The reason it exists is `local`: an OpenAI-compatible /v1/embeddings endpoint
# you run yourself, which is a different endpoint by definition rather than by
# preference. It embeds and nothing else -- refused as AI_SDK and OCR_SDK -- and
# it is the one SDK that takes no key, because a service on the compose network
# has nobody to authenticate to.
#
# What it costs, because this is not free either:
#  - No token bill and no per-document price at all. That is the point.
#  - The same work, on your CPU. A steady trickle of uploads is nothing; the
#    first backfill of an archive that already exists is the slow part, and
#    EMBEDDING_BACKFILL_BATCH is what paces it.
#  - RAM and disk for the model itself, on top of the vectors: ~2.2 GB of
#    weights for bge-m3, ~470 MB for multilingual-e5-small. Separate from the
#    tmpfs budget under VAULT_ENABLED=1, which the vectors share.
#  - A second container to keep running and to upgrade.
#
# docker-compose.embeddings-gpu.yml sets these three for you; the CPU overlay
# starts the sidecar but leaves its `app` block commented out, so set them here
# or uncomment it. See docs/local_embeddings.md.
# AI_EMBEDDING_SDK=local
# mistral | openai | openrouter | local  (google_vision has no /embeddings)
# Required for an SDK that differs from AI_SDK, except `local`, which takes none.
# AI_EMBEDDING_API_KEY=
# Optional; defaults to the SDK's own endpoint, to AI_BASE_URL when the SDKs
# match, and to http://embeddings:80/v1 for `local`.
# AI_EMBEDDING_BASE_URL=

# Read only by the compose overlays, never by the app: the model the sidecar
# loads. It is also what the overlay writes into AI_EMBEDDING_MODEL, so the two
# cannot disagree -- but changing it later is not enough on its own, because
# outside AI_MANAGED=1 the environment seeds the database on the first boot
# only. Change it in Settings -> Models too. bge-m3 is 1024 dimensions and
# multilingual; intfloat/multilingual-e5-small is 384 and a quarter of the
# index RAM.
# EMBEDDINGS_MODEL=BAAI/bge-m3
# Cores the sidecar may use. Left at the image's 8 it competes with the app for
# the same host, and a backfill would then slow the request a user is waiting on.
# EMBEDDINGS_THREADS=4
# Only for a gated model on the Hub; unset for bge-m3 and the e5 family.
# HF_TOKEN=

# How many documents one backfill tick embeds. The backfill is what covers the
# archive that already existed when you set AI_EMBEDDING_MODEL, restored
# backups, and model switches; it runs on WORKER_CRON_EXPR. 0 disables it, so
# only newly processed documents are embedded and an existing archive is left
# alone -- which is the setting to use if you want the feature without paying to
# embed a hundred thousand documents on the next restart. 0 only stops the
# schedule: Management -> Embeddings still embeds the backlog when you ask it to.
# EMBEDDING_BACKFILL_BATCH=20

# OCR, when it should not run on the provider above. Naming the same SDK as
# AI_SDK reuses that key and that endpoint, and only changes the model.
# OCR_SDK=google_vision
# mistral | openai | openrouter | google_vision | docling
# google_vision free tier: 1000 pages a month. Mistral OCR: ~625 pages a minute.
# OCR_API_KEY=
# Optional; defaults to the SDK's own endpoint, or to AI_BASE_URL when the SDKs
# match. For docling it defaults to the compose service name.
# OCR_BASE_URL=
# Required unless the SDK reads a document without one: google_vision and
# docling. For docling it optionally names the OCR engine instead of a model.
# OCR_MODEL=

# Local OCR: the engine runs in a sidecar container beside the app, from
# docker-compose.local-ocr.yml, so scanned documents are never uploaded to a
# hosted API. The SDK is KEYLESS -- no OCR_API_KEY, because there is no account
# behind it; the address below is the whole configuration, and it is already
# the default for the SDK.
#
#   docker compose -f docker-compose.yml -f docker-compose.local-ocr.yml \
#     --profile docling up -d
#
# What it costs, which is the part worth knowing before you turn it on:
#   - Disk: the image is ~4.4 GB (arm64) to ~8.7 GB (amd64), plus about a
#     gigabyte of model weights downloaded on first use.
#   - Memory: about 1.1 GB resident, against a 4 GB limit in the overlay --
#     on top of the app, and on top of the tmpfs if VAULT_ENABLED=1.
#   - Time: seconds a page on CPU against milliseconds for a hosted API, and
#     about 90 seconds to first readiness on a cold model volume. Raise
#     OCR_TIMEOUT_SEC and WORKER_TIMEOUT_SEC below.
#   - Recognition: the default engine is RapidOCR, which is PaddleOCR's PP-OCR
#     models as ONNX. Set OCR_MODEL to easyocr or tesseract to change it.
# See docs/local_ocr.md.
# OCR_SDK=docling
# OCR_BASE_URL=http://docling:5001

# The first admin account, created on the first boot that finds none. It never
# resets a password that already exists, so an admin who changes theirs keeps
# it. In a development build the SPA signs itself in with this same pair; a
# production bundle contains neither value.
#
# COMMENTED OUT ON PURPOSE, and the reason is worth reading before you uncomment
# it in something you serve. These two mint a real `_superusers` account plus its
# paired `users` account on the first boot -- they are not the dev-only Vite
# auto-login they replaced, which could never do more than fill in a form. Left
# uncommented here, `cp .env.example .env` would give every install that copied
# it an admin account whose password is published in this repository.
#
# A password in the environment is also readable from `docker inspect` and from
# /proc/<pid>/environ for the life of the container. So: local and CI instances,
# where the credentials are throwaway and skipping the wizard is the point. A
# served install should use the setup wizard, or `superuser upsert` from inside
# the container.
# SETUP_ADMIN_EMAIL=dev@lemmary.local
# SETUP_ADMIN_PASSWORD=devpassword123

# The rest of the AI settings are seeded on the first boot and edited from the
# Settings page afterwards, in both modes.
# 40 is right for a hosted API and far too low for local OCR, where a scanned
# page is seconds to tens of seconds; 300 is a starting point there. Seeded on
# the FIRST boot only -- on an instance that has already run, this variable is
# ignored and the value is changed in Settings.
OCR_TIMEOUT_SEC=40
AI_TIMEOUT_SEC=60
WORKER_TIMEOUT_SEC=300
# no auto retries by default
WORKER_MAX_RETRIES=0
EXTRACTION_PROMPT_VERSION=v1
# Comma-separated ISO 639-1 codes for Deep Search keyword expansion (e.g. de,en,uk)
DEEP_SEARCH_LANGUAGES=
# Whether the pipeline runs near-duplicate detection. Operator-owned under
# AI_MANAGED=1, so a hosted plan can price it per tier.
# NEAR_DUPLICATE_DETECTION_ENABLED=0
# NEAR_DUPLICATE_THRESHOLD=0.92

# The result language (documents' titles, tags and summaries) has no variable:
# it is a reader's preference rather than an operator's, so it is set in
# Settings and a managed instance keeps it.


# Cap on a staged split-document PDF upload, in megabytes (default 100).
# Read at startup, not from Settings; a bad value falls back to the default.
# UPLOAD_MAX_MB=100


# Instance limits. Every one is UNLIMITED when unset, so leaving this whole block
# commented out means no plan bounds this instance and no quota is shown.
# One bound is not a plan and applies regardless: a document may hold at most
# 1000 pages, because an OCR provider returns the whole document as one string
# and that string has to fit the ocr_text column. See docs/setup.md.
#
# Read at startup and never from Settings: these express what an instance is
# allowed to hold, so an admin must not be able to raise their own. Change one by
# recreating the container with a new value.
#
# An explicit 0 means zero, not unlimited -- LIMIT_ADDITIONAL_USERS=0 is a
# single-account instance. A value that cannot be read (a typo, a negative)
# falls back to unlimited and is logged at ERROR, so a stray character grants
# room rather than locking an owner out of their own archive.

# Total documents the instance may store.
# LIMIT_DOCUMENTS=1000

# Total pages across all stored documents. Anything that is not a PDF counts as
# one page, including a multi-page .docx or .xlsx.
# LIMIT_DOCUMENT_PAGES=10000

# Total bytes of stored document files. Counts the uploaded originals only, not
# thumbnails or extracted OCR text.
# LIMIT_STORAGE_BYTES=5368709120

# Largest single document file, in bytes. Can only lower the effective cap: the
# documents.file field carries its own 20 MB limit that this cannot raise.
# LIMIT_FILE_BYTES=10485760

# Most pages in a single document. Can only lower the effective cap: a 1000-page
# ceiling applies to every install and this cannot raise it.
# LIMIT_FILE_PAGES=200

# Accounts beyond the admin account. 0 means the admin only.
# LIMIT_ADDITIONAL_USERS=2

# Encryption at rest
#
# Off by default. With VAULT_ENABLED=1 the volume in VAULT_DIR holds only
# ciphertext, and the archive is decrypted into VAULT_WORKDIR -- which MUST be a
# memory-backed filesystem (tmpfs); the app refuses to start otherwise, because
# decrypting onto disk would silently void the whole feature. See
# docker-compose.encrypted.yml for a compose overlay that mounts one.
#
# Read before enabling: these are read before PocketBase exists, the instance
# boots locked and serves an unlock page, and losing every account password and
# the recovery code loses the archive. There is no operator override.
# docs/encryption.md is the full story.
# VAULT_ENABLED=1
# VAULT_DIR=/app/pb_data
# VAULT_WORKDIR=/app/work
#
# VAULT_DIR and VAULT_WORKDIR must be in separate trees; nesting one inside the
# other is refused. The working directory is emptied on every unlock, so a vault
# nested inside it would be deleted at the one moment its key existed only in
# memory.
#
# Unlock without the web form (CLI subcommands, automated tests). A passphrase in
# the environment sits next to the ciphertext it protects, so this is not how a
# server should normally be run. It is revoked the first time a real account is
# enrolled; after that the server logs that it no longer works and serves the
# unlock form instead of failing to start.
# VAULT_PASSPHRASE=
#
# Escape hatches. Keep these unset in production. Each takes a strict boolean
# (1/true/yes/on or 0/false/no/off) -- an unrecognised value refuses to start
# rather than being read as "off".
# VAULT_ALLOW_DISK_WORKDIR=1   # permit a working directory that is not tmpfs,
#                              # or one whose type cannot be checked (non-Linux)
# VAULT_ALLOW_INSECURE_GATE=1  # permit the unlock form on an address reachable
#                              # from off this host (it is served in cleartext)
# VAULT_ALLOW_SHRINK=1         # permit a flush that drops most of the archive
# VAULT_KEEP_GENERATIONS=3     # how far back a rollback can reach


# Frontend
VITE_POCKETBASE_URL=http://127.0.0.1:8090
# The dev server's auto-login reads SETUP_ADMIN_EMAIL / SETUP_ADMIN_PASSWORD
# above; there is no separate frontend copy of them.
