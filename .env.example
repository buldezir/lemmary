# Most variables below seed the database on the FIRST boot only; after that,
# change them in Settings. Full reference: docs/setup.md#environment-variables

# ── Worker ─────────────────────────────────────────────────────────────────
# Worker cron, registered at process start.
WORKER_CRON_EXPR=* * * * *

# Documents processed at once (default 1; the next job starts immediately
# anyway). Costs: N× provider rate and peak memory. Keep 1 for local OCR (it
# queues, and queued jobs time out); above 1, near-duplicates uploaded together
# may miss each other.
# WORKER_CONCURRENCY=1

# ── Import & ingest ────────────────────────────────────────────────────────
# Max staged import archive, bytes (default 1 GiB); also per-account disk use.
# IMPORT_STAGING_MAX_BYTES=1073741824

# Consume folder inside the container; subfolders become tags. Unset = off.
# Costs: one directory walk per scan, one row per file kept. docs/setup.md#ingest-folder
# INGEST_DIR=/consume

# Import mailbox attachments; configure in Settings → Ingest. Unset = off.
# Costs: one IMAP login per scan, a download per attachment; the password is
# encrypted only with VAULT_ENABLED. docs/setup.md#ingest-from-imap
# INGEST_IMAP_ENABLED=1

# Let the Paperless-ngx import reach LAN/Docker hosts. docs/paperless_ngx.md
# IMPORT_ALLOW_PRIVATE=1

# Max split-document PDF upload, MB (default 100).
# UPLOAD_MAX_MB=100

# ── Operations ─────────────────────────────────────────────────────────────
# Stdout slog level: debug | info | warn | error. Unset = no stdout tee.
# LOG_LEVEL=info

# Passkey relying party; derived from the request by default. Changing the RP ID
# invalidates every passkey. docs/passkeys.md
# PASSKEY_RP_ID=archive.example.com
# PASSKEY_ORIGINS=https://archive.example.com,https://www.archive.example.com

# Prometheus metrics on their own port. Unset = off. Costs: an unauthenticated
# port (no document text) and three queries per scrape; publish the port
# yourself. docs/setup.md#always-env-backed
# METRICS_ADDR=9464

# Read-only MCP server at /api/mcp for agents, bearer-token auth. On by default.
# Costs: an embedding request per search when embeddings are on. docs/mcp.md
# MCP_ENABLED=0

# ── AI ─────────────────────────────────────────────────────────────────────
# Self-hosted: seeds providers and models on the first boot only.
# AI_MANAGED=1 re-applies them every boot and locks them in Settings.
# docs/ai_providers.md#two-modes-one-build
# AI_MANAGED=1

# One key can be the whole setup. docs/guided_ai_setup.md
# opencode | mistral | openai | openrouter | anthropic
AI_SDK=opencode
AI_API_KEY=
# General AI model: extraction, Ask AI, search, Deep Research reads.
AI_MODEL=deepseek-v4-flash
# Defaults to the SDK's endpoint.
# AI_BASE_URL=

# Advanced model for the Deep Research loop; unset = AI_MODEL. Costs: a few long
# completions per question at this model's price. docs/deep_research.md
# AI_RESEARCH_MODEL=

# ChatGPT subscription: set up in Settings, not here. docs/chatgpt_login.md

# Embeddings for Deep Search; unset = keyword only. Costs: the whole archive is
# embedded once, again on a model change; vectors take space (RAM under
# VAULT_ENABLED). docs/ai_providers.md#what-embeddings-cost
# AI_EMBEDDING_MODEL=text-embedding-3-small

# Separate embeddings provider; unset = AI_SDK (required with opencode).
# mistral | openai | openrouter | local
# `local` is your own sidecar, no key. docs/local_embeddings.md
# AI_EMBEDDING_SDK=local
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_BASE_URL=

# Compose-overlay only: the sidecar's model, threads, HF token.
# docs/local_embeddings.md#choosing-a-model
# EMBEDDINGS_MODEL=BAAI/bge-m3
# EMBEDDINGS_THREADS=4
# HF_TOKEN=

# Documents embedded per backfill tick; 0 = only new documents.
# EMBEDDING_BACKFILL_BATCH=20

# Web search for Deep Research and Ask AI; unset = off. Costs: billed per call,
# and model-written queries may carry document text.
# docs/ai_providers.md#the-web-search-provider
# WEB_SEARCH_SDK=tavily
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_BASE_URL=

# OCR on a different provider; unset = AI_SDK. docs/ai_providers.md#ocr-per-provider
# mistral | openai | openrouter | anthropic | google_vision | docling
# OCR_SDK=google_vision
# OCR_API_KEY=
# OCR_BASE_URL=
# Not needed for google_vision or docling (for docling: the engine name).
# OCR_MODEL=

# Local OCR sidecar, no key. Costs: 4–9 GB image, ~1 GB RAM, seconds per page;
# raise the timeouts below. docs/local_ocr.md, on a Mac: docs/local_ai_macos.md
# OCR_SDK=docling
# OCR_BASE_URL=http://docling:5001

# Timeouts, seconds. Local OCR wants ~300.
OCR_TIMEOUT_SEC=90
AI_TIMEOUT_SEC=90
WORKER_TIMEOUT_SEC=300
WORKER_MAX_RETRIES=0
EXTRACTION_PROMPT_VERSION=v1
# ISO 639-1 codes for Deep Search keyword expansion, e.g. de,en,uk
DEEP_SEARCH_LANGUAGES=
# Context-window catalogue; one request per provider per day.
# AI_MODEL_CATALOG_URL=https://pi.dev/api/models/providers
# docs/setup.md#duplicate-detection
# NEAR_DUPLICATE_DETECTION_ENABLED=0
# NEAR_DUPLICATE_THRESHOLD=0.92

# ── First admin ────────────────────────────────────────────────────────────
# Creates a real admin on first boot and dev auto-login. Local/CI only: the
# password is visible in `docker inspect`. docs/setup.md#first-launch-setup-wizard
# SETUP_ADMIN_EMAIL=dev@lemmary.local
# SETUP_ADMIN_PASSWORD=devpassword123

# ── Instance limits ────────────────────────────────────────────────────────
# Unset = unlimited; 0 means zero. Read at startup only. docs/setup.md#instance-limits
# LIMIT_DOCUMENTS=1000
# Non-PDF files count as one page.
# LIMIT_DOCUMENT_PAGES=10000
# Stored originals only.
# LIMIT_STORAGE_BYTES=5368709120
# Can only lower the 47 MB field limit.
# LIMIT_FILE_BYTES=10485760
# Can only lower the 1000-page ceiling.
# LIMIT_FILE_PAGES=200
# Accounts beyond the admin.
# LIMIT_ADDITIONAL_USERS=2

# ── Encryption at rest ─────────────────────────────────────────────────────
# Workdir must be tmpfs, boots locked, no operator recovery. Read
# docs/encryption.md first; overlay: docker-compose.encrypted.yml
# VAULT_ENABLED=1
# VAULT_DIR=/app/pb_data
# VAULT_WORKDIR=/app/work
# Unattended unlock (CLI/tests); revoked once an account enrols.
# VAULT_PASSPHRASE=
# Escape hatches, never in production:
# VAULT_ALLOW_DISK_WORKDIR=1
# VAULT_ALLOW_INSECURE_GATE=1
# VAULT_ALLOW_SHRINK=1
# VAULT_KEEP_GENERATIONS=3

# ── Frontend ───────────────────────────────────────────────────────────────
VITE_POCKETBASE_URL=http://127.0.0.1:8090
