# direnv (https://direnv.net): run `direnv allow` once and every go command in
# this tree picks the build tag up, editors and gopls included.
#
# Without it, `go build` fails on internal/fulltext/vectors_required.go: bleve
# compiles its kNN API out unless `vectors` is set, so this is not an optional
# feature flag but the only configuration the backend builds in.
#
# No direnv? Either pass `-tags vectors` to every go command, or set it once:
#
#     go env -w GOFLAGS=-tags=vectors
#
# (go env -w is per user, not per project -- fine when Lemmary is the only cgo
# tree you work in, wrong if it is not.)
export GOFLAGS=-tags=vectors
export CGO_ENABLED=1

# A FAISS built into your home directory rather than /usr/local -- what
# scripts/faiss-build.sh suggests when it is run without root -- is invisible to
# the compiler and the loader unless they are told. Setting these only when the
# directory exists keeps a system-wide install (the common case) untouched.
if [ -d "$HOME/.local/faiss/lib" ]; then
  export CGO_CFLAGS="-I$HOME/.local/faiss/include"
  export CGO_LDFLAGS="-L$HOME/.local/faiss/lib"
  export LD_LIBRARY_PATH="$HOME/.local/faiss/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
