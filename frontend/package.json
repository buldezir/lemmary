  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "scripts": {
    "dev": "vite --host ${DEV_HOST:-127.0.0.1} --port 5173",
    "build": "tsc -b && vite build && pnpm run docs:build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "docs:dev": "vitepress dev --host ${DEV_HOST:-127.0.0.1} --port 5174",
    "docs:build": "vitepress build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/router-devtools": "^1.167.2",
    "pocketbase": "^0.28.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1",
    "vue": "^3.5.42"
